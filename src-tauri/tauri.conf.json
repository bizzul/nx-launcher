{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NX Launcher",
  "version": "0.2.2",
  "identifier": "dev.nxlauncher.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NX Launcher",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/icons/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QzQwMTBBNUFCRjdDQkIKUldTN2ZMOWFDZ0hFOS9pVUVjR041a1BuSWZuMWMrd1RNV09SVEtCQUxnUXlmaGdHZU1EZDNkOTIK",
      "endpoints": [
        "https://github.com/bizzul/nx-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
